# ── Database (PostgreSQL 16 + pgvector) ─────────────────────────────
DATABASE_URL="postgresql://supportai:supportai@127.0.0.1:5433/supportai"

# ── Auth ────────────────────────────────────────────────────────────
# Signs session cookies (min 32 chars). Generate: openssl rand -base64 32
AUTH_SECRET=""

# ── LLM provider (Vercel AI SDK) ────────────────────────────────────
OPENAI_API_KEY=""                      # required in production
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"   # must output 1536 dims (vector(1536))
RAG_MIN_SIMILARITY=0.3                 # relevance cutoff; tune with the Evals page

# ── Local dev / tests only ──────────────────────────────────────────
# AI_PROVIDER="mock"                   # offline LLM + embeddings, no API key needed
# ALLOW_MOCK_PROVIDER=1                # required to use the mock when NODE_ENV=production (e.g. E2E tests)
# SEED_DEMO_DATA=1                     # seed demo customers/admin even in production (off by default there)
# TEST_DATABASE_URL="postgresql://supportai:supportai@127.0.0.1:5433/supportai_test"
# MOCK_CHUNK_DELAY_MS=10                # streaming speed of the mock model (E2E)
